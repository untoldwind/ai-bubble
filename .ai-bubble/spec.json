{
  "$schema": "../ai-bubble.spec.schema.json",
  "cwd": "${PWD}",
  "env": {
    "values": {
      "HOME": "${HOME}",
      "PATH": "${PATH}",
      "TERM": "${TERM}"
    }
  },
  "hostfs": {
    "mappings": [
      {
        "glob": "${PWD}",
        "type": "rw"
      },
      {
        "glob": [
          "/usr",
          "/lib",
          "/lib64",
          "/bin",
          "${HOME}/.rustup"
        ],
        "type": "ro"
      },
      {
        "path": [
          "${HOME}/.cargo",
          "${HOME}/.local",
          "${HOME}/.config/opencode"
        ],
        "type": "project-cache"
      },
      {
        "path": "${HOME}/.cache",
        "type": "session-cache"
      },
      {
        "dest": "${HOME}/.config/opencode/opencode.jsonc",
        "source": "conf/opencode.jsonc",
        "type": "redirect-ro"
      },
      {
        "type": "dev"
      },
      {
        "type": "proc"
      },
      {
        "path": [
          "/run",
          "/tmp"
        ],
        "type": "tmpfs"
      }
    ]
  },
  "net": {
    "allow": [
      "registry.cube.home:80",
      "registry.cube.home:443",
      "google.com:443",
      "*.crates.io:443",
      "opencode.ai:443",
      "models.opencode.ai:443",
      "registry.npmjs.org:443",
      "github.com:443",
      "api.github.com:443",
      "*.githubusercontent.com:443",
      "ai.bettermarks.com:443",
      "api.tokenfactory.nebius.com:443",
      "api.together.ai:443",
      "api.together.xyz:443"
    ],
    "mode": "waf"
  },
  "seccomp": {
    "preset": "strict"
  }
}

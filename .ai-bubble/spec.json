{
  "$schema": "../ai-bubble.spec.schema.json",
  "hostfs": {
    "mappings": [
      {
        "type": "ro",
        "glob": "/usr"
      },
      {
        "type": "ro",
        "glob": "/lib"
      },
      {
        "type": "ro",
        "glob": "/lib64"
      },
      {
        "type": "ro",
        "glob": "/bin"
      },
      {
        "type": "ro",
        "glob": "${HOME}/.rustup"
      },
      {
        "type": "project-cache",
        "path": "${HOME}/.cargo"
      },
      {
        "type": "project-cache",
        "path": "${HOME}/.local"
      },
      {
        "type": "session-cache",
        "path": "${HOME}/.cache"
      },
      {
        "type": "project-cache",
        "path": "${HOME}/.config/opencode"
      },
      {
        "type": "redirect-rw",
        "source": "conf",
        "dest": "${HOME}/.config/opencode"
      },
      {
        "type": "rw",
        "glob": "${PWD}"
      },
      {
        "type": "hide",
        "glob": "${PWD}/h/*secret*"
      },
      {
        "type": "dev"
      },
      {
        "type": "ro",
        "glob": "/etc/ssl"
      },
      {
        "type": "ro",
        "glob": "/etc/ca-certificates"
      },
      {
        "type": "proc"
      },
      {
        "type": "empty",
        "path": "/net"
      },
      {
        "type": "tmpfs",
        "path": "/run"
      },
      {
        "type": "tmpfs",
        "path": "/tmp"
      }
    ]
  },
  "cwd": "${PWD}",
  "net": {
    "mode": "proxy",
    "allow": [
      "google.com:443",
      "*.crates.io:443",
      "opencode.ai:443",
      "models.opencode.ai:443",
      "registry.npmjs.org:443",
      "github.com:443",
      "api.github.com:443",
      "*.githubusercontent.com:443",
      "ai.bettermarks.com:443",
      "api.tokenfactory.nebius.com:443",
      "api.together.ai:443"
    ]
  },
  "env": {
    "env_file": "${HOME}/workspaces/o1/ai-sandbox/.env",
    "values": {
      "PATH": "${PATH}",
      "HOME": "${HOME}",
      "TERM": "${TERM}"
    }
  }
}

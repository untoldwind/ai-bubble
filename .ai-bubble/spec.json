{
  "$schema": "../ai-bubble.spec.schema.json",
  "hostfs": {
    "mappings": [
      {
        "type": "rw",
        "glob": "${PWD}"
      },
      {
        "type": "ro",
        "glob": ["/usr", "/lib", "/lib64", "/bin", "${HOME}/.rustup"]
      },
      {
        "type": "project-cache",
        "path": ["${HOME}/.cargo", "${HOME}/.local", "${HOME}/.config/opencode"]
      },
      {
        "type": "session-cache",
        "path": "${HOME}/.cache"
      },
      {
        "type": "redirect-ro",
        "source": "conf/opencode.jsonc",
        "dest": "${HOME}/.config/opencode/opencode.jsonc"
      },
      {
        "type": "dev"
      },
      {
        "type": "proc"
      },
      {
        "type": "empty",
        "path": "/net"
      },
      {
        "type": "tmpfs",
        "path":["/run", "/tmp"]
      }
    ]
  },
  "cwd": "${PWD}",
  "net": {
    "mode": "waf",
    "allow": [
      "registry.cube.home:80",
      "registry.cube.home:443",
      "google.com:443",
      "*.crates.io:443",
      "opencode.ai:443",
      "models.opencode.ai:443",
      "registry.npmjs.org:443",
      "github.com:443",
      "api.github.com:443",
      "*.githubusercontent.com:443",
      "ai.bettermarks.com:443",
      "api.tokenfactory.nebius.com:443",
      "api.together.ai:443"
    ]
  },
  "env": {
    "env_file": "${HOME}/workspaces/o1/ai-sandbox/.env",
    "values": {
      "PATH": "${PATH}",
      "HOME": "${HOME}",
      "TERM": "${TERM}"
    }
  },
  "seccomp": { "preset": "strict" }
}

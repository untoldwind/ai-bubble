{
  "ops": [
    { "type": "bind",    "src": "/usr", "dest": "/usr" },
    { "type": "bind",    "src": "/etc", "dest": "/etc" },
    { "type": "dev",     "dest": "/dev" },
    { "type": "tmpfs",   "dest": "/tmp" },
    { "type": "tmpfs",   "dest": "/run" }
  ],
  "hostfs": {
    "root": true,
    "mirror": [
      "/home/bjunglas/workspaces",
      "/lib",
      "/lib64",
      "/bin"
    ],
    "emptyDirs": [
      "/dev",
      "/usr",
      "/etc",
      "/proc",
      "/net",
      "/run",
      "/tmp"
    ]
  },
  "proc": "/proc",
  "net": { "isolated": true, "allow": ["google.com:443", "opencode.ai:443"] }
}

{
  "$schema": "./rs-bubble.spec.schema.json",
  "hostfs": {
    "mappings": [
      {
        "type": "rw",
        "glob": "/home/bjunglas/workspaces"
      },
      {
        "type": "ro",
        "glob": "/usr"
      },
      {
        "type": "ro",
        "glob": "/lib"
      },
      {
        "type": "ro",
        "glob": "/lib64"
      },
      {
        "type": "ro",
        "glob": "/bin"
      },
      {
        "type": "hide",
        "glob": "/home/bjunglas/workspaces/**/target"
      },
      {
        "type": "dev",
        "path": "/dev"
      },
      {
        "type": "bind",
        "path": "/etc"
      },
      {
        "type": "empty",
        "path": "/proc"
      },
      {
        "type": "empty",
        "path": "/net"
      },
      {
        "type": "tmpfs",
        "path": "/run"
      },
      {
        "type": "tmpfs",
        "path": "/tmp"
      }
    ]
  },
  "proc": "/proc",
  "net": {
    "isolated": true,
    "allow": [
      "google.com:443",
      "opencode.ai:443"
    ]
  }
}

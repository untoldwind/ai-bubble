{
  "$schema": "./rs-bubble.spec.schema.json",
  "ops": [
    { "type": "bind",    "src": "/usr", "dest": "/usr" },
    { "type": "bind",    "src": "/etc", "dest": "/etc" },
    { "type": "dev",     "dest": "/dev" },
    { "type": "tmpfs",   "dest": "/tmp" },
    { "type": "tmpfs",   "dest": "/run" }
  ],
  "hostfs": {
    "root": true,
    "mirror": {
      "/home/bjunglas/workspaces": "mirror",
      "/lib": "mirror",
      "/lib64": "mirror",
      "/bin": "mirror",
      "/home/bjunglas/workspaces/**/target": "hide"
    },
    "emptyDirs": [
      "/dev",
      "/usr",
      "/etc",
      "/proc",
      "/net",
      "/run",
      "/tmp"
    ]
  },
  "proc": "/proc",
  "net": { "isolated": true, "allow": ["google.com:443", "opencode.ai:443"] }
}

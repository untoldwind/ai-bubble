{
  "$schema": "./rs-bubble.spec.schema.json",
  "ops": [
    { "type": "bind",    "src": "/usr", "dest": "/usr" },
    { "type": "bind",    "src": "/etc", "dest": "/etc" },
    { "type": "dev",     "dest": "/dev" },
    { "type": "tmpfs",   "dest": "/tmp" },
    { "type": "tmpfs",   "dest": "/run" }
  ],
  "hostfs": {
    "root": true,
    "patterns": {
      "/home/bjunglas/workspaces": "rw",
      "/lib": "ro",
      "/lib64": "ro",
      "/bin": "ro",
      "/home/bjunglas/workspaces/**/target": "hide",
      "/dev": "empty",
      "/usr": "empty",
      "/etc": "empty",
      "/proc": "empty",
      "/net": "empty",
      "/run": "empty",
      "/tmp": "empty"
    }
  },
  "proc": "/proc",
  "net": { "isolated": true, "allow": ["google.com:443", "opencode.ai:443"] }
}

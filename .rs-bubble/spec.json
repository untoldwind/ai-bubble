{
  "$schema": "./rs-bubble.spec.schema.json",
  "hostfs": {
    "mappings": [
      {
        "type": "ro",
        "glob": "/usr"
      },
      {
        "type": "ro",
        "glob": "/lib"
      },
      {
        "type": "ro",
        "glob": "/lib64"
      },
      {
        "type": "ro",
        "glob": "/bin"
      },
      {
        "type": "ro",
        "glob": "${HOME}/.rustup"
      },
      {
        "type": "project-cache",
        "path": "${HOME}/.cargo"
      },
      {
        "type": "project-cache",
        "path": "${HOME}/.local"
      },
      {
        "type": "session-cache",
        "path": "${HOME}/.cache"
      },
      {
        "type": "project-cache",
        "path": "${HOME}/.config/opencode"
      },
      {
        "type": "redirect-rw",
        "source": "conf",
        "dest": "${HOME}/.config/opencode"
      },
      {
        "type": "rw",
        "glob": "${PWD}"
      },
      {
        "type": "dev"
      },
      {
        "type": "bind",
        "path": "/etc"
      },
      {
        "type": "proc"
      },
      {
        "type": "empty",
        "path": "/net"
      },
      {
        "type": "tmpfs",
        "path": "/run"
      },
      {
        "type": "tmpfs",
        "path": "/tmp"
      }
    ]
  },
  "cwd": "${PWD}",
  "net": {
    "isolated": true,
    "allow": [
      "google.com:443",
      "index.crates.io:443",
      "static.crates.io:443",
      "opencode.ai:443",
      "models.opencode.ai:443",
      "registry.npmjs.org:443",
      "github.com:443",
      "api.github.com:443",
      "ai.bettermarks.com:443",
      "api.tokenfactory.nebius.com:443",
      "api.together.ai:443"
    ]
  },
  "env": {
    "PATH": "${PATH}",
    "HOME": "${HOME}",
    "TERM": "${TERM}",
    "NEBIUS_TOKEN": "${NEBIUS_TOKEN}",
    "TOGETHER_AI_TOKEN": "${TOGETHER_AI_TOKEN}"
  }
}

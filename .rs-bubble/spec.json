{
  "$schema": "./rs-bubble.spec.schema.json",
  "hostfs": {
    "mappings": [
      {
        "type": "ro",
        "glob": "/usr"
      },
      {
        "type": "ro",
        "glob": "/lib"
      },
      {
        "type": "ro",
        "glob": "/lib64"
      },
      {
        "type": "ro",
        "glob": "/bin"
      },
      {
        "type": "redirect-rw",
        "source": "conf",
        "dest": "${HOME}/.config/opencode"
      },
      {
        "type": "rw",
        "glob": "${HOME}/workspaces"
      },
      {
        "type": "hide",
        "glob": "${HOME}/workspaces/**/target"
      },
      {
        "type": "dev"
      },
      {
        "type": "bind",
        "path": "/etc"
      },
      {
        "type": "proc"
      },
      {
        "type": "empty",
        "path": "/net"
      },
      {
        "type": "tmpfs",
        "path": "/run"
      },
      {
        "type": "tmpfs",
        "path": "/tmp"
      }
    ]
  },
  "net": {
    "isolated": true,
    "allow": [
      "google.com:443",
      "opencode.ai:443"
    ]
  }
}
